generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Donor {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  firstName  String
  lastName   String
  phone      String
  email      String @unique
  bloodGroup String
  age        Int
  address    String
  state      String
  city       String
  gender     String
  // New fields for intelligent matching and availability
  latitude        Float?
  longitude       Float?
  lastDonation    DateTime?
  available       Boolean @default(true)
  role            String   @default("donor") // 'donor' | 'recipient' | 'admin'
}

model DonorOrg {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  OrganisationName    String
  OrganisationPhone   String
  OrganisationEmail   String @unique
  OrganisationAddress String
  OrganisationState   String
  OrganisationCity    String
}

// Track SOS/emergency requests from recipients
model RecipientRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recipientName String
  recipientPhone String
  recipientEmail String?
  bloodGroup     String
  message        String?
  latitude       Float
  longitude      Float
  radiusKm       Float   @default(10)
  status         String  @default("active") // 'active' | 'fulfilled' | 'cancelled'
  createdAt      DateTime @default(now())
}

// Optional: blood bank stock for live map
model BloodBank {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String?
  email     String?
  address   String
  state     String
  city      String
  latitude  Float?
  longitude Float?
  // Store stock as JSON, e.g., { "A+": 10, "O-": 3 }
  stock     Json?
  updatedAt DateTime @updatedAt
}
